-- NOCLIP
local function startNoclip()
	noclipActive = true
	if noclipConnection then noclipConnection:Disconnect() end
	noclipConnection = RunService.Stepped:Connect(function()
		if not noclipActive then return end
		local char = player.Character
		if char then
			for _, part in pairs(char:GetChildren()) do
				if part:IsA("BasePart") then
					local pName = part.Name
					if pName == "HumanoidRootPart" or pName == "Torso" or pName == "UpperTorso" or pName == "LowerTorso" then
						part.CanCollide = false
					else
						part.CanCollide = true
					end
				end
			end
		end
	end)
end

local function stopNoclip()
	noclipActive = false
	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end
	local char = player.Character
	if char then
		for _, part in pairs(char:GetChildren()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end
end

-- SEARCH PLAYER
local function getTargetPlayer(targetName)
	targetName = string.lower(targetName)
	for _, p in pairs(game.Players:GetPlayers()) do
		if p ~= player then
			if string.find(string.lower(p.Name), targetName) or string.find(string.lower(p.DisplayName), targetName) then
				return p
			end
		end
	end
	return nil
end

local function gotoPlayer(targetName)
	if not targetName or targetName == "" then return end
	local target = getTargetPlayer(targetName)
	if target then
		tpToTargetPlayer(target)
	end
end

