local function startFly()
	flying = true
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")
	local hum = char:WaitForChild("Humanoid")

	hum.PlatformStand = true

	local bodyVel = Instance.new("BodyVelocity")
	bodyVel.Name = "CamFlyVel"
	bodyVel.MaxForce = Vector3.new(4e5, 4e5, 4e5)
	bodyVel.Velocity = Vector3.zero
	bodyVel.Parent = hrp

	local bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "CamFlyGyro"
	bodyGyro.MaxTorque = Vector3.new(4e5, 4e5, 4e5)
	bodyGyro.CFrame = hrp.CFrame
	bodyGyro.Parent = hrp

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flying or not hrp:FindFirstChild("CamFlyVel") then return end
		local cam = workspace.CurrentCamera
		bodyGyro.CFrame = cam.CFrame

		local moveVector = Vector3.zero
		if ControlModule then moveVector = ControlModule:GetMoveVector() else moveVector = hum.MoveDirection end

		if moveVector.Magnitude > 0 then
			local forwardDir = cam.CFrame.LookVector * (-moveVector.Z)
			local rightDir = cam.CFrame.RightVector * (moveVector.X)
			bodyVel.Velocity = (forwardDir + rightDir).Unit * flySpeed
		else
			bodyVel.Velocity = Vector3.zero
		end
	end)
end

local function stopFly()
	flying = false
	if flyConnection then flyConnection:Disconnect() end
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then hum.PlatformStand = false end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then
			if hrp:FindFirstChild("CamFlyVel") then hrp.CamFlyVel:Destroy() end
			if hrp:FindFirstChild("CamFlyGyro") then hrp.CamFlyGyro:Destroy() end
		end
	end
end

player.Chatted:Connect(function(msg)
	if not cmdsActive then return end
	local splitMsg = string.split(msg, " ")
	local cmd = string.lower(splitMsg[1])

	if cmd == ":fly" then
		if flying then stopFly() else startFly() end
	elseif cmd == ":unfly" then
		stopFly()
	elseif cmd == ":anti" and string.lower(splitMsg[2] or "") == "fling" or cmd == ":antifling" then
		enableAntiFling()
	elseif cmd == ":onfling" then
		disableAntiFling()
	elseif cmd == ":noclip" then
		startNoclip()
	elseif cmd == ":clip" or cmd == ":unnoclip" then
		stopNoclip()
	elseif cmd == ":goto" or cmd == ":to" then
		local targetName = splitMsg[2]
		if targetName then gotoPlayer(targetName) end
	elseif cmd == ":reset" or cmd == ":re" then
		resetCharacter()
	end
end)

