local function sendChatMessage(msgText)
	if not msgText or msgText == "" then return end
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
		if generalChannel then generalChannel:SendAsync(msgText) end
	else
		local chatEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
		if chatEvent then
			local sayMsg = chatEvent:FindFirstChild("SayMessageRequest")
			if sayMsg then sayMsg:FireServer(msgText, "All") end
		end
	end
end

