	if not botGotoActive then return end
	if string.find(string.lower(messageText), "bot") then
		local senderPlayer = game.Players:FindFirstChild(senderName)
		if senderPlayer and senderPlayer ~= player then tpToTargetPlayer(senderPlayer) end
	end
end

