end

local function getTargetPlayer(targetName)
	targetName = string.lower(targetName)
	for _, p in pairs(game.Players:GetPlayers()) do
		if p ~= player then
			if string.find(string.lower(p.Name), targetName) or string.find(string.lower(p.DisplayName), targetName) then return p end
		end
	end
	return nil
end

