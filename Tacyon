local function attachOwnerTag(character)
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso then return end

	local existingTag = torso:FindFirstChild("TachyonOwnerTag")
	if existingTag then existingTag:Destroy() end

	local bb = Instance.new("BillboardGui")
	bb.Name = "TachyonOwnerTag"
	bb.Size = UDim2.new(0, 180, 0, 40)
	bb.StudsOffset = Vector3.new(0, 0, 0)
	bb.AlwaysOnTop = true
	bb.Adornee = torso
	bb.Parent = torso

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = "TACHYON OWNER"
	label.Font = Enum.Font.SourceSansBold
	label.TextSize = 18
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.2
	label.Parent = bb

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 0, 255)), -- Ungu
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 162, 255))   -- Biru
	}
	gradient.Rotation = 45
	gradient.Parent = label
end

RunService.Heartbeat:Connect(function()
	for _, p in pairs(Players:GetPlayers()) do
		if OWNER_USERNAMES[p.Name] and p.Character then
			local torso = p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso")
			if torso and not torso:FindFirstChild("TachyonOwnerTag") then
				attachOwnerTag(p.Character)
			end
		end
	end
end)

