local function updateHumanoidStats()
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			if isSpeedSet then hum.WalkSpeed = customSpeed end
			if isJumpSet then hum.UseJumpPower = true hum.JumpPower = customJump end
		end
	end
end

