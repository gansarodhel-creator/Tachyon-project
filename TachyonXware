local playerBrickTimestamps = {}
local lastWarningTime = {}

local function monitorPlayerFolder(playerFolder)
	playerFolder.ChildAdded:Connect(function(child)
		if not spamAlarmEnabled then return end
		if child:IsA("BasePart") then
			local playerName = playerFolder.Name
			local now = tick()
			
			if not playerBrickTimestamps[playerName] then
				playerBrickTimestamps[playerName] = {}
			end
			
			table.insert(playerBrickTimestamps[playerName], now)
			
			local validTimestamps = {}
			for _, t in ipairs(playerBrickTimestamps[playerName]) do
				if now - t <= 2.0 then
					table.insert(validTimestamps, t)
				end
			end
			playerBrickTimestamps[playerName] = validTimestamps
			
			if #playerBrickTimestamps[playerName] >= 10 then
				if not lastWarningTime[playerName] or (now - lastWarningTime[playerName] > 4.0) then
					lastWarningTime[playerName] = now
					executePublicChat("warning " .. playerName .. " is building too fast 🚨🚨")
				end
			end
		end
	end)
end

local bricksFolder = workspace:FindFirstChild("Bricks")
if bricksFolder then
	for _, pf in ipairs(bricksFolder:GetChildren()) do
		if pf:IsA("Folder") or pf:IsA("Model") then
