local function gotoPlayer(name)
	if not name or name == "" then return end
	name = string.lower(name)
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and (string.find(string.lower(p.Name), name) or string.find(string.lower(p.DisplayName), name)) then
			local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if hrp and myHrp then myHrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -3) end
			return
		end
	end
end

----------------------------------------------------------
-- PERFECT 3D FLY & LOOP SPEED VARIABLES
----------------------------------------------------------
local flying = false
local flySpeed = 50
local flyConnection = nil
local loopSpeedActive = false
local targetLoopSpeed = 16

local function startFly()
	if flying then return end
	flying = true
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then flying = false return end

	hum.PlatformStand = true

	local bv = Instance.new("BodyVelocity")
	bv.Name = "TachyonFlyVelocity"
	bv.Parent = hrp
	bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bv.Velocity = Vector3.new(0, 0, 0)

	local bg = Instance.new("BodyGyro")
	bg.Name = "TachyonFlyGyro"
	bg.Parent = hrp
	bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	bg.P = 9000
	bg.CFrame = hrp.CFrame

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flying or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
			if bv then bv:Destroy() end
			if bg then bg:Destroy() end
			if flyConnection then flyConnection:Disconnect() end
			return
		end
		
		local cam = workspace.CurrentCamera
		bg.CFrame = cam.CFrame

		local moveDir = Vector3.new(0, 0, 0)
		local UserInputService = game:GetService("UserInputService")
		local isKeyboardMoving = false
		
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector isKeyboardMoving = true end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector isKeyboardMoving = true end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector isKeyboardMoving = true end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector isKeyboardMoving = true end
		
		if not isKeyboardMoving and hum.MoveDirection.Magnitude > 0 then
			local flatLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
			if flatLook.Magnitude > 0.001 then
				flatLook = flatLook.Unit
				local flatRight = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z).Unit
				local fwd = hum.MoveDirection:Dot(flatLook)
				local rgt = hum.MoveDirection:Dot(flatRight)
				moveDir = (cam.CFrame.LookVector * fwd) + (cam.CFrame.RightVector * rgt)
			end
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir -= Vector3.new(0, 1, 0) end

		if moveDir.Magnitude > 1 then moveDir = moveDir.Unit end
		bv.Velocity = moveDir * flySpeed
	end)
	sendBlueChatMessage("[TACHYON] Perfect Fly Enabled ✈️")
end

local function stopFly()
	flying = false
	if flyConnection then flyConnection:Disconnect() end
	local char = player.Character
	if char then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hrp then
			if hrp:FindFirstChild("TachyonFlyVelocity") then hrp.TachyonFlyVelocity:Destroy() end
			if hrp:FindFirstChild("TachyonFlyGyro") then hrp.TachyonFlyGyro:Destroy() end
		end
		if hum then hum.PlatformStand = false end
	end
	sendBlueChatMessage("[TACHYON] Fly Disabled ❌")
end

