local function createTab(tabName, layoutOrder)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Size = UDim2.new(1, 0, 0, 28)
	tabBtn.Text = tabName
	tabBtn.TextColor3 = Color3.fromRGB(160, 160, 170)
	tabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
	tabBtn.Font = Enum.Font.SourceSansBold
	tabBtn.TextSize = 13
	tabBtn.LayoutOrder = layoutOrder
	tabBtn.Parent = sidebar

	styleButton(tabBtn, Color3.fromRGB(30, 30, 38), Color3.fromRGB(20, 20, 26))

	local pageFrame = Instance.new("Frame")
	pageFrame.Size = UDim2.new(1, 0, 1, 0)
	pageFrame.BackgroundTransparency = 1
	pageFrame.Visible = false
	pageFrame.Parent = contentArea

	tabFrames[tabName] = pageFrame
	tabButtons[tabName] = tabBtn

	tabBtn.MouseButton1Click:Connect(function()
		for name, frame in pairs(tabFrames) do frame.Visible = (name == tabName) end
		for name, btn in pairs(tabButtons) do
			if name == tabName then
				styleButton(btn, Color3.fromRGB(0, 140, 255), Color3.fromRGB(0, 80, 180))
				btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			else
				styleButton(btn, Color3.fromRGB(30, 30, 38), Color3.fromRGB(20, 20, 26))
				btn.TextColor3 = Color3.fromRGB(160, 160, 170)
			end
		end
	end)

	return pageFrame
end

