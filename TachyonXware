-- ANTI-DRAG SYSTEM
----------------------------------------------------------
local antiDragConnection
local antiDragEnabled = false

local function StopAntiDrag()
	if antiDragConnection then
		antiDragConnection:Disconnect()
		antiDragConnection = nil
	end
end

local function StartAntiDrag()
	StopAntiDrag()
	local timer = 0
	antiDragConnection = RunService.Heartbeat:Connect(function(dt)
		if not antiDragEnabled then return end
		timer += dt
		if timer < 0.1 then return end
		timer = 0

		local char = plr.Character
		if not char then return end
		local humanoid = char:FindFirstChildWhichIsA("Humanoid")
		if not humanoid then return end

		local dragger = char:FindFirstChild("Dragger")
		if dragger then
			pcall(function() dragger.ResponseStyle = Enum.DragDetectorResponseStyle.Custom end)
		end

		if humanoid.PlatformStand or humanoid.Sit then
			humanoid.PlatformStand = false
			humanoid.Sit = false
			pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		end
	end)
end

plr.CharacterAdded:Connect(function()
	if antiDragEnabled then
		task.wait(0.5)
		if antiDragEnabled then StartAntiDrag() end
	end
end)

