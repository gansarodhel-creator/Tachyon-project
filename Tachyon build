----------------------------------------------------------
-- 1. GLOBAL SPY RECORDER (INCREASE + DECREASE + PAINT)
----------------------------------------------------------
local partActions = {}

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
	local method = getnamecallmethod()
	
	if method == "FireServer" and tostring(self.Name) == "Event" then
		local args = {...}
		
		task.spawn(function()
			pcall(function()
				local tool = self:FindFirstAncestorOfClass("Tool")
				local toolName = tool and tool.Name or ""
				
				if toolName == "Shape" then
					local action = tostring(args[4])
					local targetPart = args[1]
					
					-- Merekam aksi "decrease" maupun "increase" secara akurat
					if (action == "decrease" or action == "increase") and typeof(targetPart) == "Instance" and targetPart:IsA("BasePart") then
						if not partActions[targetPart] then partActions[targetPart] = {} end
						
						table.insert(partActions[targetPart], {
							Type = "Shape",
							ActionType = action, -- Menyimpan status "increase" atau "decrease"
							NormalId = args[2] or Enum.NormalId.Top
						})
					end
					
				elseif toolName == "Paint" then
					local targetPart = args[1]
					if typeof(targetPart) == "Instance" and targetPart:IsA("BasePart") then
						if not partActions[targetPart] then partActions[targetPart] = {} end
						
						table.insert(partActions[targetPart], {
							Type = "Paint",
							NormalId = args[2] or Enum.NormalId.Top,
							ColorMode = args[4],
							ColorObj = args[5],
							Material = args[6],
							Extra = args[7]
						})
					end
					
				elseif toolName == "Delete" then
					local targetPart = args[1]
					if typeof(targetPart) == "Instance" and targetPart:IsA("BasePart") then
						partActions[targetPart] = nil
					end
				end
			end)
		end)
	end
	
	return oldNamecall(self, ...)
end)

----------------------------------------------------------
-- TOOL HELPERS
----------------------------------------------------------
local function equipTool(name)
	local char = player.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	
	local tool = char:FindFirstChild(name)
	if tool then return tool end
	
	local bpTool = player.Backpack:FindFirstChild(name)
	if bpTool and hum then
		hum:EquipTool(bpTool)
		task.wait(0.08)
		return bpTool
	end
	return nil
end

local function getRemote(toolName)
	local tool = equipTool(toolName)
	if not tool then return nil end
	local s = tool:FindFirstChild("Script") or tool:FindFirstChildOfClass("LocalScript")
	if s then return s:FindFirstChild("Event") or s:FindFirstChildOfClass("RemoteEvent") end
	return tool:FindFirstChild("Event") or tool:FindFirstChildOfClass("RemoteEvent")
end

local function getSurfaceVector(part, normalId)
	local pos = part.Position
	local size = part.Size
	
	if normalId == Enum.NormalId.Top then
		return Vector3.new(pos.X, pos.Y + (size.Y / 2), pos.Z)
	elseif normalId == Enum.NormalId.Bottom then
		return Vector3.new(pos.X, pos.Y - (size.Y / 2), pos.Z)
	elseif normalId == Enum.NormalId.Back then
		return Vector3.new(pos.X, pos.Y, pos.Z - (size.Z / 2))
	elseif normalId == Enum.NormalId.Front then
		return Vector3.new(pos.X, pos.Y, pos.Z + (size.Z / 2))
	elseif normalId == Enum.NormalId.Right then
		return Vector3.new(pos.X + (size.X / 2), pos.Y, pos.Z)
	elseif normalId == Enum.NormalId.Left then
		return Vector3.new(pos.X - (size.X / 2), pos.Y, pos.Z)
	end
	
	return Vector3.new(pos.X, pos.Y + (size.Y / 2), pos.Z)
end

----------------------------------------------------------
-- SAVE & LOAD CORE
----------------------------------------------------------
local function getFileName(slotName)
	return "Tachyon_Build_" .. slotName .. ".json"
end

local function saveBuilding(slotName, statusLabel)
	local rawBricks = {}
	local bFolder = workspace:FindFirstChild("Bricks")
	if not bFolder then return end

	local myFolder = bFolder:FindFirstChild(player.Name)
	if not myFolder then return end

	for _, obj in ipairs(myFolder:GetChildren()) do
		if obj:IsA("BasePart") then
			local actions = partActions[obj] or {}
			local serializedActions = {}
			for _, act in ipairs(actions) do
				if act.Type == "Shape" then
					table.insert(serializedActions, {
						Type = "Shape",
						ActionType = act.ActionType, -- Menyimpan aksi "increase" / "decrease"
						NormalName = tostring(act.NormalId.Name)
					})
				elseif act.Type == "Paint" then
					table.insert(serializedActions, {
						Type = "Paint",
						NormalName = tostring(act.NormalId.Name),
						ColorMode = act.ColorMode,
						HasColor = (act.ColorObj ~= nil),
						R = act.ColorObj and act.ColorObj.R or 0,
						G = act.ColorObj and act.ColorObj.G or 0,
						B = act.ColorObj and act.ColorObj.B or 0,
						Material = act.Material,
						Extra = act.Extra
					})
				end
			end
			table.insert(rawBricks, {
				Pos = {X = obj.Position.X, Y = obj.Position.Y, Z = obj.Position.Z},
				Actions = serializedActions
			})
		end
	end

	pcall(function()
		if writefile then
			writefile(getFileName(slotName), HttpService:JSONEncode(rawBricks))
		end
	end)

	if statusLabel then
		statusLabel.Text = "Saved: " .. slotName .. " (" .. #rawBricks .. " blocks)"
	end
end

local function loadBuilding(slotName, statusLabel)
	local rawBricks = {}
	pcall(function()
		if readfile then
			local success, content = pcall(readfile, getFileName(slotName))
			if success and content then
				rawBricks = HttpService:JSONDecode(content)
			end
		end
	end)

	if not rawBricks or #rawBricks == 0 then
		if statusLabel then statusLabel.Text = "Slot '" .. slotName .. "' is empty!" end
		return
	end

	local buildRem = getRemote("Build")
	if not buildRem then
		if statusLabel then statusLabel.Text = "Build tool missing!" end
		return
	end

	task.spawn(function()
		if statusLabel then statusLabel.Text = "Loading " .. slotName .. "..." end
		local bFolder = workspace:FindFirstChild("Bricks")
		local myFolder = bFolder and bFolder:FindFirstChild(player.Name)

		for _, data in ipairs(rawBricks) do
			local currentBuildRem = getRemote("Build")
			if not currentBuildRem then break end

			local targetPos = Vector3.new(data.Pos.X, data.Pos.Y, data.Pos.Z)
			local newPart = nil
			local conn = nil

			if myFolder then
				conn = myFolder.ChildAdded:Connect(function(child)
					if child:IsA("BasePart") then newPart = child end
				end)
			end

			pcall(function()
				currentBuildRem:FireServer(workspace.Terrain, Enum.NormalId.Top, targetPos, "normal")
			end)

			local timer = 0
			while not newPart and timer < 0.6 do
				task.wait(0.03)
				timer = timer + 0.03
			end
			if conn then conn:Disconnect() end

			if not newPart and myFolder then
				for _, p in ipairs(myFolder:GetChildren()) do
					if p:IsA("BasePart") and (Vector2.new(p.Position.X, p.Position.Z) - Vector2.new(targetPos.X, targetPos.Z)).Magnitude < 1.5 then
						newPart = p
						break
					end
				end
			end

			if newPart and data.Actions and #data.Actions > 0 then
				local shapeRem = getRemote("Shape")
				local paintRem = getRemote("Paint")

				for _, act in ipairs(data.Actions) do
					local targetNormal = Enum.NormalId[act.NormalName] or Enum.NormalId.Top
					local surfaceVector = getSurfaceVector(newPart, targetNormal)

					if act.Type == "Shape" and shapeRem then
						local actString = act.ActionType or "decrease"
						local args = { [1] = newPart, [2] = targetNormal, [3] = surfaceVector, [4] = actString }
						pcall(function() shapeRem:FireServer(unpack(args)) end)

						local oldSize = newPart.Size
						local waitTimeout = 0
						while newPart and newPart.Parent and (newPart.Size - oldSize).Magnitude < 0.05 and waitTimeout < 1.0 do
							task.wait(0.05)
							waitTimeout = waitTimeout + 0.05
						end
						task.wait(0.06)

					elseif act.Type == "Paint" and paintRem then
						local colorVal = act.HasColor and Color3.new(act.R, act.G, act.B) or nil
						local args = { [1] = newPart, [2] = targetNormal, [3] = surfaceVector, [4] = act.ColorMode, [5] = colorVal, [6] = act.Material, [7] = act.Extra or "" }
						pcall(function() paintRem:FireServer(unpack(args)) end)
						task.wait(0.08)
					end
				end
			end
			task.wait(0.05)
		end

		if statusLabel then statusLabel.Text = "Loaded " .. slotName .. "!" end
	end)
end

