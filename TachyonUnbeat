local function spawnElectricSpark(button)
	local numSparks = math.random(10, 16)
	local colors = {
		Color3.fromRGB(0, 255, 255),
		Color3.fromRGB(160, 230, 255),
		Color3.fromRGB(255, 255, 255),
		Color3.fromRGB(0, 180, 255)
	}

	for _ = 1, numSparks do
		task.spawn(function()
			local spark = Instance.new("Frame")
			local sparkLength = math.random(15, 32)
			spark.Size = UDim2.new(0, sparkLength, 0, 3)
			spark.Position = UDim2.new(0.5, 0, 0.5, 0)
			spark.AnchorPoint = Vector2.new(0.5, 0.5)
			spark.BackgroundColor3 = colors[math.random(1, #colors)]
			spark.BorderSizePixel = 0
			spark.ZIndex = button.ZIndex + 20
			spark.Parent = button

			local corner = Instance.new("UICorner", spark)
			corner.CornerRadius = UDim.new(1, 0)

			local glow = Instance.new("UIStroke", spark)
			glow.Color = Color3.fromRGB(0, 220, 255)
			glow.Thickness = 1.5
			glow.Transparency = 0.1

			local angle = math.rad(math.random(0, 360))
			local distance = math.random(35, 80)
			local targetX = math.cos(angle) * distance
			local targetY = math.sin(angle) * distance
			spark.Rotation = math.deg(angle)

			local duration = math.random(18, 35) / 100

			local moveTween = TweenService:Create(spark, TweenInfo.new(duration, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
				Position = UDim2.new(0.5, targetX, 0.5, targetY),
				Size = UDim2.new(0, 0, 0, 1),
				BackgroundTransparency = 1,
				Rotation = spark.Rotation + math.random(-45, 45)
			})

			local strokeTween = TweenService:Create(glow, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Transparency = 1
			})

			moveTween:Play()
			strokeTween:Play()

			moveTween.Completed:Connect(function()
				spark:Destroy()
			end)
		end)
	end
end

