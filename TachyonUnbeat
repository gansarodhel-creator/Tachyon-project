----------------------------------------------------------
-- ANTI GLITCH SYSTEM (TELEPORT / FLING SAFEGUARD)
----------------------------------------------------------
local antiGlitchEnabled = false
local antiGlitchConnection = nil
local lastSafeCFrame = nil
local MAX_DISPLACEMENT_THRESHOLD = 800

local function setAntiGlitch(state)
	antiGlitchEnabled = state
	if antiGlitchEnabled then
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then lastSafeCFrame = hrp.CFrame end

		if antiGlitchConnection then antiGlitchConnection:Disconnect() end
		antiGlitchConnection = RunService.Heartbeat:Connect(function()
			if not antiGlitchEnabled then return end
			local c = player.Character
			local root = c and c:FindFirstChild("HumanoidRootPart")
			local hum = c and c:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 then
				if not lastSafeCFrame then
					lastSafeCFrame = root.CFrame
					return
				end

				local dist = (root.Position - lastSafeCFrame.Position).Magnitude
				local speed = root.AssemblyLinearVelocity.Magnitude

				if dist >= MAX_DISPLACEMENT_THRESHOLD or speed >= 3500 then
					pcall(function()
						root.AssemblyLinearVelocity = Vector3.zero
						root.AssemblyAngularVelocity = Vector3.zero
						root.CFrame = lastSafeCFrame
					end)
					sendBlueChatMessage("[TACHYON] Anti Glitch: Glitch terdeteksi! Posisi dikembalikan 🛡️⚠️")
				else
					lastSafeCFrame = root.CFrame
				end
			end
		end)
		sendBlueChatMessage("[TACHYON] Anti Glitch Activated: ON 🌀🛡️")
	else
		if antiGlitchConnection then
			antiGlitchConnection:Disconnect()
			antiGlitchConnection = nil
		end
		lastSafeCFrame = nil
		sendBlueChatMessage("[TACHYON] Anti Glitch Deactivated: OFF ❌")
	end
end

player.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	if antiGlitchEnabled then
		local hrp = char:WaitForChild("HumanoidRootPart", 5)
		if hrp then lastSafeCFrame = hrp.CFrame end
	end
end)

