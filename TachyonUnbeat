local function sendBlueChatMessage(msgText)
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if generalChannel then
				generalChannel:DisplaySystemMessage("<font color='#00A2FF'><b>" .. msgText .. "</b></font>")
			end
		else
			StarterGui:SetCore("ChatMakeSystemMessage", {
				Text = msgText,
				Color = Color3.fromRGB(0, 162, 255),
				Font = Enum.Font.SourceSansBold,
				TextSize = 18
			})
		end
	end)
end

local function executePublicChat(msgText)
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if ch then ch:SendAsync(msgText) end
		else
			local chatEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			if chatEvent and chatEvent:FindFirstChild("SayMessageRequest") then
				chatEvent.SayMessageRequest:FireServer(msgText, "All")
			end
		end
	end)
end

