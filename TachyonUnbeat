local function setupChatListener(p)
	p.Chatted:Connect(function(msg)
		if autoBotChatEnabled and p ~= player then
			local myChar = player.Character
			local otherChar = p.Character
			if myChar and otherChar then
				local myHrp = myChar:FindFirstChild("HumanoidRootPart")
				local otherHrp = otherChar:FindFirstChild("HumanoidRootPart")
				if myHrp and otherHrp then
					local distance = (myHrp.Position - otherHrp.Position).Magnitude
					if distance <= 15 then
						local lowerMsg = string.lower(msg)
						if string.find(lowerMsg, "hi") or string.find(lowerMsg, "hello") or string.find(lowerMsg, "halo") or string.find(lowerMsg, "hey") then
							task.wait(0.4)
							executePublicChat("ohh hello!!, how are you buddy?? 😃😃")
						end
					end
				end
			end
		end
	end)
end

