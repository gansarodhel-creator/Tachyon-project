local function triggerGriefAlert(attacker, victimOwnerName)
	if attacker.Name == victimOwnerName then return end
	local now = tick()
	local lastWarn = lastGriefWarning[attacker.Name] or 0
	if now - lastWarn >= 3.0 then
		lastGriefWarning[attacker.Name] = now
		executePublicChat("warning " .. attacker.Name .. " is detected deleting people building 🚨🚨")
	end
end

local function identifyTrueDeleter(brickPosition, victimOwnerName)
	local closestPlayer = nil
	local shortestDist = 45

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Name ~= victimOwnerName then
			local char = p.Character
			if char and char:FindFirstChild("Delete") then
				local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
				if hrp then
					local dist = (hrp.Position - brickPosition).Magnitude
					local toBrick = (brickPosition - hrp.Position).Unit
					local dot = hrp.CFrame.LookVector:Dot(toBrick)

					if dist < shortestDist and dot > 0.15 then
						shortestDist = dist
						closestPlayer = p
					end
				end
			end
		end
	end

	return closestPlayer
end

local function attachClickDetectorToBrick(brick, ownerFolder)
	if not brick:IsA("BasePart") or activeClickDetectors[brick] then return end
	activeClickDetectors[brick] = true

	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 45
	cd.Parent = brick

	cd.MouseClick:Connect(function(clickingPlayer)
		if not griefAlarmEnabled then return end
		if clickingPlayer ~= player and clickingPlayer.Name ~= ownerFolder.Name then
			local char = clickingPlayer.Character
			if char and char:FindFirstChild("Delete") then
				triggerGriefAlert(clickingPlayer, ownerFolder.Name)
			end
		end
	end)

	brick.AncestryChanged:Connect(function(_, newParent)
		if not newParent and griefAlarmEnabled then
			local trueCulprit = identifyTrueDeleter(brick.Position, ownerFolder.Name)
			if trueCulprit then
				triggerGriefAlert(trueCulprit, ownerFolder.Name)
			end
		end
	end)
end

local function monitorBricksFolder(pFolder)
	for _, child in ipairs(pFolder:GetChildren()) do
		attachClickDetectorToBrick(child, pFolder)
	end
	pFolder.ChildAdded:Connect(function(child)
		attachClickDetectorToBrick(child, pFolder)
	end)
end

