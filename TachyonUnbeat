-- ANTI KILLBRICK SYSTEM (AUTO DISARM TOUCH & IMMUNITY)
----------------------------------------------------------
local antiKillbrickEnabled = false
local antiKillbrickLoop = nil
local originalCanTouchCache = {}

local function neutralisePart(part)
	if part:IsA("BasePart") then
		local isMyChar = false
		if player.Character and part:IsDescendantOf(player.Character) then
			isMyChar = true
		end
		if not isMyChar then
			for _, child in ipairs(part:GetChildren()) do
				if child:IsA("TouchTransmitter") then
					pcall(function() child:Destroy() end)
				end
			end
			if part.CanTouch then
				originalCanTouchCache[part] = true
				pcall(function() part.CanTouch = false end)
			end
		end
	end
end

local function restoreNeutralisedParts()
	for part, val in pairs(originalCanTouchCache) do
		if part and part.Parent then
			pcall(function() part.CanTouch = val end)
		end
	end
	originalCanTouchCache = {}
end

local function setAntiKillbrick(state)
	antiKillbrickEnabled = state
	if antiKillbrickEnabled then
		task.spawn(function()
			for _, desc in ipairs(workspace:GetDescendants()) do
				if not antiKillbrickEnabled then break end
				neutralisePart(desc)
			end
		end)

		antiKillbrickLoop = RunService.Stepped:Connect(function()
			if not antiKillbrickEnabled then return end
			local char = player.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					pcall(function()
						hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
					end)
				end
			end
		end)
		sendBlueChatMessage("[TACHYON] Anti Killbrick Activated: ON 🛡️🧱")
	else
		if antiKillbrickLoop then
			antiKillbrickLoop:Disconnect()
			antiKillbrickLoop = nil
		end
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				pcall(function()
					hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
				end)
			end
		end
		restoreNeutralisedParts()
		sendBlueChatMessage("[TACHYON] Anti Killbrick Deactivated: OFF ❌")
	end
end

