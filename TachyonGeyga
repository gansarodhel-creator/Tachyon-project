local function clearFog()
	for _, obj in ipairs(Lighting:GetChildren()) do
		if obj:IsA("Atmosphere") then
			obj:Destroy()
		end
	end
	pcall(function()
		Lighting.FogEnd = 100000
		Lighting.FogStart = 0
	end)
	sendBlueChatMessage("[TACHYON] Fog Cleared Successfully! ☀️")
