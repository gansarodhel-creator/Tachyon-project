		toggleAntiFling(true)
		sendBlueChatMessage("[TACHYON] Anti-Fling Activated ✅")
	elseif cmd == ":unantifling" then
		toggleAntiFling(false)
		sendBlueChatMessage("[TACHYON] Anti-Fling Deactivated ❌")
	elseif cmd == ":fov" then
		local val = tonumber(args[2])
		if val then setFov(val) end
	elseif cmd == ":pov" or cmd == ":goto" or cmd == ":to" then
		if args[2] then gotoPlayer(args[2]) end
	elseif cmd == ":antilag" then
