----------------------------------------------------------
-- DISARM DEATH SYSTEM (AUTO-BACKSPACE)
----------------------------------------------------------
local disarmDeathEnabled = false
local droppedItems = {}
local isDropping = false

local function triggerDropSequence()
	if isDropping or not disarmDeathEnabled then return end
	isDropping = true
	
	local char = player.Character
	if not char then isDropping = false return end
	
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then isDropping = false return end

	local toolsToDrop = {}
	if player:FindFirstChild("Backpack") then
		for _, t in ipairs(player.Backpack:GetChildren()) do
			if t:IsA("Tool") then table.insert(toolsToDrop, t) end
		end
	end
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then table.insert(toolsToDrop, t) end
	end

	if #toolsToDrop > 0 then
		sendBlueChatMessage("[TACHYON] Auto-dropping " .. #toolsToDrop .. " items via Backspace...")
		task.spawn(function()
			for _, tool in ipairs(toolsToDrop) do
				if not char or not char.Parent then break end
				
				if hum.Health <= 0 then
					pcall(function() tool.Parent = workspace end)
				else
					pcall(function() hum:EquipTool(tool) end)
					task.wait(0.05) 
					VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Backspace, false, game)
					task.wait(0.05)
					VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Backspace, false, game)
					task.wait(0.05)
				end
				table.insert(droppedItems, tool)
			end
			isDropping = false
		end)
	else
		isDropping = false
	end
end

local function monitorHealth(char)
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end
	
	hum.HealthChanged:Connect(function(health)
		if health <= 5 and health > 0 and disarmDeathEnabled then
			triggerDropSequence()
		end
	end)
	
	hum.Died:Connect(function()
		triggerDropSequence()
	end)
end

player.CharacterAdded:Connect(function(newChar)
	isDropping = false
	monitorHealth(newChar)
	
	if disarmDeathEnabled then
		task.spawn(function()
			task.wait(2)
			local recovered = 0
			local hrp = newChar:WaitForChild("HumanoidRootPart", 5)
			
			if hrp then
				for _, tool in ipairs(droppedItems) do
					if tool and tool.Parent == workspace then
						pcall(function()
							if tool:FindFirstChild("Handle") then
								tool.Handle.CFrame = hrp.CFrame
							end
						end)
						pcall(function()
							tool.Parent = player.Backpack
						end)
						recovered = recovered + 1
					end
				end
			end
			droppedItems = {}
			if recovered > 0 then
				sendBlueChatMessage("[TACHYON] Recovered " .. recovered .. " items! 🎒")
			end
		end)
	end
end)

if player.Character then
	monitorHealth(player.Character)
end

----------------------------------------------------------
-- ANTI-DRAG SYSTEM
----------------------------------------------------------
local antiDragConnection
local antiDragEnabled = false

local function StopAntiDrag()
	if antiDragConnection then
		antiDragConnection:Disconnect()
		antiDragConnection = nil
	end
end

local function StartAntiDrag()
	StopAntiDrag()
	local timer = 0

	antiDragConnection = RunService.Heartbeat:Connect(function(dt)
		if not antiDragEnabled then return end
		timer += dt
		if timer < 0.1 then return end
		timer = 0

		local char = plr.Character
		if not char then return end

		local humanoid = char:FindFirstChildWhichIsA("Humanoid")
		if not humanoid then return end

		local dragger = char:FindFirstChild("Dragger")
		if dragger then
			pcall(function()
				dragger.ResponseStyle = Enum.DragDetectorResponseStyle.Custom
			end)
		end

		if humanoid.PlatformStand or humanoid.Sit then
			humanoid.PlatformStand = false
			humanoid.Sit = false

			pcall(function()
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
	end)
end

plr.CharacterAdded:Connect(function()
	if antiDragEnabled then
		task.wait(0.5)
		if antiDragEnabled then
			StartAntiDrag()
		end
	end
end)

