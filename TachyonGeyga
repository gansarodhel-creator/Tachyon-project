local function uncursed()
	for _, obj in ipairs(Lighting:GetChildren()) do
		if obj:IsA("ColorCorrectionEffect") then
			pcall(function()
				obj.Saturation = 0
			end)
		end
	end
	sendBlueChatMessage("[TACHYON] Uncursed: RGB Saturation set to 0! ✨")
end

