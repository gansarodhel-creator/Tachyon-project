local hiddenfling = false
local function flingProcess()
	local c, hrp, vel, movel = nil, nil, nil, 0.1
	while hiddenfling do
		RunService.Heartbeat:Wait()
		c = player.Character
		hrp = c and c:FindFirstChild("HumanoidRootPart")
		if hrp then
			vel = hrp.Velocity
			hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
			RunService.RenderStepped:Wait()
			hrp.Velocity = vel
			RunService.Stepped:Wait()
			hrp.Velocity = vel + Vector3.new(0, movel, 0)
			movel = -movel
		end
	end
end

flingBtn.MouseButton1Click:Connect(function()
	hiddenfling = not hiddenfling
	if hiddenfling then
		flingBtn.Text = "Fling Touch: ON"
		styleButton(flingBtn, Color3.fromRGB(0, 200, 100), Color3.fromRGB(0, 120, 60))
		task.spawn(flingProcess)
	else
		flingBtn.Text = "Fling Touch: OFF"
		styleButton(flingBtn, Color3.fromRGB(50, 50, 60), Color3.fromRGB(30, 30, 40))
	end
end)

-- Tombol DelCubes menggunakan RemoteEvent 'Event' asli milik game
local delCubesBtn = Instance.new("TextButton")
delCubesBtn.Size = UDim2.new(0, 220, 0, 32)
delCubesBtn.Text = "DelCubes"
delCubesBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
delCubesBtn.Font = Enum.Font.SourceSansBold
delCubesBtn.TextSize = 13
delCubesBtn.LayoutOrder = 2
delCubesBtn.Parent = trollTab
styleButton(delCubesBtn, Color3.fromRGB(220, 50, 50), Color3.fromRGB(150, 30, 30))

delCubesBtn.MouseButton1Click:Connect(function()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChild("Backpack")
	
	-- Equip tool Delete jika ada
	local deleteTool = (backpack and backpack:FindFirstChild("Delete")) or (char and char:FindFirstChild("Delete"))
	if deleteTool and hum then
		pcall(function() hum:EquipTool(deleteTool) end)
		sendBlueChatMessage("[TACHYON] DelCubes: Tool 'Delete' equipped! 🗑️")
		task.wait(0.1)
	end
	
	local remoteEvent = player:FindFirstChild("Event")
	local bricksFolder = workspace:FindFirstChild("Bricks")
	
	if bricksFolder and remoteEvent then
		local count = 0
		for _, playerFolder in ipairs(bricksFolder:GetChildren()) do
			-- Jangan hapus folder milik player sendiri jika ingin aman, atau hapus semua folder player lain
			if playerFolder.Name ~= player.Name then
				for _, brick in ipairs(playerFolder:GetChildren()) do
					if brick:IsA("BasePart") then
						pcall(function()
							-- Kirim koordinat posisi brick ke server lewat RemoteEvent 'Event' untuk menghapusnya secara server-side
							local args = {
								[1] = brick,
								[2] = Enum.NormalId.Top,
								[3] = brick.Position,
								[4] = "delete" -- Mengubah parameter aksi menjadi delete (atau mencoba mengirim referensi brick)
							}
							remoteEvent:FireServer(unpack(args))
							
							-- Cadangan alternatif jika server membaca posisi
							local argsPos = {
								[1] = brick,
								[2] = Enum.NormalId.Top,
								[3] = brick.Position,
								[4] = "normal"
							}
							remoteEvent:FireServer(unpack(argsPos))
							
							count = count + 1
						end)
					end
				end
			end
		end
		sendBlueChatMessage("[TACHYON] Sent delete request for " .. count .. " bricks via server event! ✨")
	else
		sendBlueChatMessage("[TACHYON] Error: Bricks folder or Player Event not found!")
	end
end)

