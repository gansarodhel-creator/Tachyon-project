local function setFov(fov)
	if typeof(fov) == "number" and fov >= 1 and fov <= 120 then
		workspace.CurrentCamera.FieldOfView = fov
	end
end

local function antiLag()
	local bricks = workspace:FindFirstChild("Bricks")
	if not bricks then return end
	local names = { Disintegrate=1, Spray=1, Fire=1, CRFire=1, Field=1, Light=1 }
	for _, obj in ipairs(bricks:GetDescendants()) do
		if names[obj.Name] then pcall(function() obj.Enabled = false end) end
	end
end

local function antiVamp()
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
	workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	workspace.CurrentCamera.CameraSubject = hum
	if hum.WalkSpeed == 0 then hum.WalkSpeed = 16 end
end

local autoGrabEnabled = false
local pickupLoop = nil
local function startAutoGrab()
	autoGrabEnabled = true
	pickupLoop = task.spawn(function()
		while autoGrabEnabled do
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				for _, obj in ipairs(workspace:GetChildren()) do
					if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
						pcall(function() hum:EquipTool(obj) end)
					end
				end
			end
			task.wait(0.1)
		end
	end)
end

local function stopAutoGrab()
	autoGrabEnabled = false
	if pickupLoop then task.cancel(pickupLoop) end
end

local function antiVisual()
	for _, v in pairs(Lighting:GetChildren()) do if v:IsA("BlurEffect") then v:Destroy() end end
	for _, gui in pairs(PlayerGui:GetChildren()) do
		if gui:IsA("ScreenGui") and (string.find(string.lower(gui.Name), "blind") or string.find(string.lower(gui.Name), "dark")) then gui:Destroy() end
	end
	Lighting.Brightness = 2
end

local function rainbowSystemMsg(msg)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
		if ch then ch:DisplaySystemMessage("<font color='#FF00FF'><b>[SPY] "..msg.."</b></font>") end
	end
end

local function gotoPlayer(name)
	if not name or name == "" then return end
	name = string.lower(name)
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and (string.find(string.lower(p.Name), name) or string.find(string.lower(p.DisplayName), name)) then
			local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if hrp and myHrp then myHrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -3) end
			return
		end
	end
end

