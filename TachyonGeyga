		antiDragEnabled = false
		StopAntiDrag()
		antiDragBtn.Text = "Anti Drag: OFF"
		styleButton(antiDragBtn, Color3.fromRGB(50, 50, 60), Color3.fromRGB(30, 30, 40))
		sendBlueChatMessage("[TACHYON] Anti-Drag Deactivated ❌")
