local function styleButton(btn, startColor, endColor)
	btn.AutoButtonColor = true
	btn.BackgroundColor3 = startColor

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = btn

	local stroke = btn:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Transparency = 0.8
	stroke.Thickness = 1
	stroke.Parent = btn

	local gradient = btn:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	gradient.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, startColor),
		ColorSequenceKeypoint.new(1, endColor)
	}
	gradient.Rotation = 90
	gradient.Parent = btn
end

